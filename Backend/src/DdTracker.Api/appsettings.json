{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=dndtracker.db"
  },
  "AlertJob": {
    "IntervalMinutes": 2,
    "WarningDaysThreshold": 2
  },
  "Cors":{
    "AllowedOrigins":["http://localhost:4200"]
  }
}